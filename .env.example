# Copy this to .env and adjust the values: cp .env.example .env

# User/group ID (find yours on Mac/Linux with `id -u` and `id -g`)
PUID=1000
PGID=1000
TZ=Europe/Budapest

# Where your files live on disk (absolute or relative path)
MEDIA_MOVIES_PATH=./media/movies
MEDIA_TV_PATH=./media/tv
DOWNLOADS_PATH=./downloads

# qBittorrent login - this is ALWAYS re-enforced on every startup (if you
# change it through the WebUI, the next `docker compose up`/restart resets
# it back to this value - .env is the single source of truth, change it here)
QBIT_USER=admin
QBIT_PASS=admin

# Grafana admin password - this only takes effect on the VERY FIRST startup
# (after that, Grafana stores it in its own database). To reset it back to
# admin/admin, `docker compose down -v` wipes Grafana's database (the
# dashboards reload automatically from files, so those are not lost).
GRAFANA_ADMIN_PASSWORD=admin

# Shared secret between the linker app and Watchtower's HTTP API - only used
# internally between containers, you never type this anywhere yourself.
WATCHTOWER_API_TOKEN=changeme-token

# Which network interface the services should be reachable on (Plex, Sonarr,
# Radarr, Prowlarr, qBittorrent, Seerr, Grafana, Prometheus, linker):
#   0.0.0.0    -> reachable from your whole local network (phone, TV, etc.)
#   127.0.0.1  -> only reachable from this machine, nobody else on the network sees it
# WARNING: with the default admin/admin passwords above, 0.0.0.0 means anyone
# on your local network can log into these UIs - if you're not on a trusted
# network, either set real passwords above or switch this to 127.0.0.1.
BIND_ADDRESS=0.0.0.0

# Plex claim token (optional, only needed on first startup).
# Get one while logged in here: https://www.plex.tv/claim/ (valid for 5 minutes)
PLEX_CLAIM=

# This machine's LAN IP (or hostname) - used to build the "Open" links in
# the linker's own dashboard (http://SERVER_IP:<port>, always plain http,
# never https). Set this to whatever IP/hostname you actually use to reach
# this box, e.g. 192.168.1.50. Leave as localhost only if you're running
# everything on the same machine you browse from.
SERVER_IP=localhost
